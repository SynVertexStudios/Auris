    <string name="word_delimiter_section_title">Delimitadores de Palabra Actuales</string>
    <string name="word_delimiter_section_subtitle">Estas palabras clave dividen nombres de artistas cuando están rodeadas por espacios. Coincide sin distinguir mayúsculas/minúsculas. Toca para eliminar.</string>
    <string name="word_delimiter_empty">Ningún delimitador de palabra configurado</string>
