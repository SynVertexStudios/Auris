    <string name="word_delimiter_section_subtitle">Ces mots-clés divisent les noms d\'artistes lorsqu\'ils sont entourés d\'espaces. Correspond sans tenir compte de la casse. Appuyez pour supprimer.</string>
    <string name="word_delimiter_empty">Aucun délimiteur de mot configuré</string>
